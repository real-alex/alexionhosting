# =============================================================================
# Alexion Hosting — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Each app also reads these; see docs/DEVELOPMENT.md for per-app details.
# -----------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
NODE_ENV=development

# --- Supabase (platform database + auth) -------------------------------------
# Create a project at https://supabase.com and copy these from
# Project Settings -> API and Project Settings -> Database.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Used by the API to verify Supabase-issued JWTs (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=your-jwt-secret
# Direct Postgres connection (Settings -> Database -> Connection string).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# --- Web dashboard (apps/web, Next.js) ---------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser — only put public keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Alexion Hosting

# --- Central API (apps/api, NestJS) ------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of origins allowed to call the API (the web dashboard).
API_CORS_ORIGINS=http://localhost:3000

# --- Node agent (apps/agent) -------------------------------------------------
AGENT_PORT=5000
AGENT_HOST=0.0.0.0
# Shared secret the API uses to authenticate with the agent. Generate a long
# random string, e.g. `openssl rand -hex 32`. MUST match AGENT_TOKEN below.
AGENT_TOKEN=change-me-to-a-long-random-secret
# How the API reaches this agent (one agent per host/node).
AGENT_BASE_URL=http://localhost:5000
# Where the agent stores per-server data on the host (volumes, backups).
AGENT_DATA_DIR=./data/servers
AGENT_BACKUP_DIR=./data/backups
# Docker connection. Leave blank to use the local Docker socket.
DOCKER_SOCKET=/var/run/docker.sock

# --- Game server provisioning defaults ---------------------------------------
# Public port range allocated to customer game servers (UDP for SA-MP/CRMP).
GAME_PORT_RANGE_START=7777
GAME_PORT_RANGE_END=7877
# Default published host that customers connect their game client to.
GAME_PUBLIC_HOST=127.0.0.1

# --- Per-server game database (MariaDB/MySQL) --------------------------------
# Root credentials for the MariaDB instance the agent provisions databases on.
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_ROOT_USER=root
GAME_DB_ROOT_PASSWORD=change-me
